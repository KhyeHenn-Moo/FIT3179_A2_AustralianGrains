{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 520,
  "title": {
    "text": "Grain production density by Statistical Area Level 2",
    "subtitle": [
      "Levied production per square kilometre, for the selected crop and year",
      "Source: Australian Bureau of Statistics"
    ],
    "anchor": "start",
    "frame": "bounds"
  },
  "params": [
    {
      "name": "crop",
      "value": "Wheat"
    },
    {
      "name": "year",
      "value": "2024-25"
    },
    {
      "name": "breaks",
      "value": {
        "Wheat": [
          1,
          5,
          20,
          50
        ],
        "Barley": [
          0.5,
          2,
          10,
          30
        ],
        "Oats": [
          0.05,
          0.2,
          1,
          4
        ],
        "Sorghum": [
          0.1,
          0.5,
          2,
          8
        ]
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ],
    "center": [
      0,
      -27
    ]
  },
  "layer": [
    {
      "data": {
        "url": "js/sa2_2021.topojson",
        "format": {
          "type": "topojson",
          "feature": "SA2_2021_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STE_NAME21 != 'Other Territories' && datum.properties.STE_NAME21 != 'Outside Australia'"
        },
        {
          "calculate": "'No ' + lower(crop) + ' production reported for ' + year",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "#ffffff",
        "strokeWidth": 0.1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.SA2_NAME21",
            "title": "Statistical Area Level 2"
          },
          {
            "field": "properties.STE_NAME21",
            "title": "State"
          },
          {
            "field": "note",
            "title": "Data"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/grain_sa2.csv",
        "format": {
          "type": "csv",
          "parse": {
            "SA2_CODE21": "string",
            "tonnes": "number",
            "km2": "number",
            "tonnes_per_km2": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.crop === crop && datum.year === year"
        },
        {
          "calculate": "datum.tonnes_per_km2 < breaks[datum.crop][0] ? 0 : datum.tonnes_per_km2 < breaks[datum.crop][1] ? 1 : datum.tonnes_per_km2 < breaks[datum.crop][2] ? 2 : datum.tonnes_per_km2 < breaks[datum.crop][3] ? 3 : 4",
          "as": "class"
        },
        {
          "lookup": "SA2_CODE21",
          "from": {
            "data": {
              "url": "js/sa2_2021.topojson",
              "format": {
                "type": "topojson",
                "feature": "SA2_2021_AUST_GDA2020"
              }
            },
            "key": "properties.SA2_CODE21"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.1
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "class",
          "type": "ordinal",
          "scale": {
            "domain": [
              0,
              1,
              2,
              3,
              4
            ],
            "range": [
              "#fef0d9",
              "#fdcc8a",
              "#fc8d59",
              "#e34a33",
              "#b30000"
            ]
          },
          "legend": {
            "title": "Tonnes per square kilometre",
            "labelExpr": "datum.value == 0 ? 'Under ' + breaks[crop][0] : datum.value == 4 ? breaks[crop][3] + ' and over' : breaks[crop][datum.value - 1] + ' – ' + breaks[crop][datum.value]"
          }
        },
        "tooltip": [
          {
            "field": "SA2_NAME21",
            "title": "Statistical Area Level 2"
          },
          {
            "field": "crop",
            "title": "Crop"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "tonnes_per_km2",
            "title": "Tonnes per square kilometre",
            "format": ",.2f"
          },
          {
            "field": "tonnes",
            "title": "Total tonnes",
            "format": ","
          },
          {
            "field": "km2",
            "title": "Area (square kilometres)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "js/states_2021.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#555555",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Western Australia",
            "lon": 122.5,
            "lat": -25.0
          },
          {
            "name": "Northern Territory",
            "lon": 133.4,
            "lat": -19.5
          },
          {
            "name": "South Australia",
            "lon": 134.5,
            "lat": -30.0
          },
          {
            "name": "Queensland",
            "lon": 144.5,
            "lat": -22.5
          },
          {
            "name": "Victoria",
            "lon": 144.3,
            "lat": -39.4
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "name"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "New South Wales",
            "lon": 154.3,
            "lat": -31.5
          },
          {
            "name": "Tasmania",
            "lon": 149.2,
            "lat": -42.2
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333",
        "align": "left",
        "dx": 4
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "name"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}