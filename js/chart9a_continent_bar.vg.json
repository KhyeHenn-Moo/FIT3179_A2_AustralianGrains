{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 560,
  "height": 240,
  "title": {
    "text": "Asia buys almost all of Australia's grain exports",
    "subtitle": [
      "Australian exports in 2024 by the continent of the buyer, in thousand tonnes",
      "Source: Food and Agriculture Organization of the United Nations"
    ],
    "anchor": "start",
    "frame": "bounds"
  },
  "params": [
    {
      "name": "crop",
      "value": "All Grains"
    }
  ],
  "data": {
    "url": "data/exports_continent.csv",
    "format": {
      "type": "csv",
      "parse": {
        "tonnes": "number",
        "tonnes_kt": "number",
        "share_pct": "number",
        "n_buyers": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.crop === crop"
    },
    {
      "calculate": "(datum.tonnes_kt < 1 ? 'under 1' : format(datum.tonnes_kt, ',.0f')) + '  (' + (datum.share_pct < 0.1 ? 'under 0.1' : format(datum.share_pct, '.1f')) + '%)'",
      "as": "lbl"
    }
  ],
  "encoding": {
    "y": {
      "field": "continent",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": null,
        "labelFontSize": 12,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "tonnes_kt",
      "type": "quantitative",
      "axis": {
        "title": "Exports in 2024 (thousand tonnes)",
        "grid": true,
        "format": ",.0f"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.7
        }
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.continent === 'Asia'",
            "value": "#d94801"
          },
          "value": "#bdbdbd"
        },
        "tooltip": [
          {
            "field": "continent",
            "title": "Continent"
          },
          {
            "field": "crop",
            "title": "Grain"
          },
          {
            "field": "tonnes",
            "title": "Exports 2024 (tonnes)",
            "format": ",.0f"
          },
          {
            "field": "share_pct",
            "title": "Share of grain exports (percent)",
            "format": ".1f"
          },
          {
            "field": "n_buyers",
            "title": "Buyer countries"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 11,
        "color": "#333333"
      },
      "encoding": {
        "text": {
          "field": "lbl"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}