{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 760,
  "height": 420,
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "autosize": "pad",
  "title": {
    "text": "Who buys Australian grain in Asia, and where Malaysia fits",
    "subtitle": [
      "Tile area is Australian exports in 2024, grouped by United Nations sub-region",
      "Tile numbers are in thousand tonnes. Malaysia is outlined in blue",
      "Source: Food and Agriculture Organization of the United Nations"
    ],
    "anchor": "start",
    "offset": 8
  },
  "signals": [
    {
      "name": "crop",
      "value": "All Grains"
    }
  ],
  "data": [
    {
      "name": "leaves",
      "url": "data/exports_asia.csv",
      "format": {
        "type": "csv",
        "parse": {
          "tonnes": "number",
          "share_of_asia_pct": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.crop === crop"
        }
      ]
    },
    {
      "name": "region_totals",
      "source": "leaves",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "subregion"
          ],
          "fields": [
            "tonnes"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "tree",
      "source": "leaves",
      "transform": [
        {
          "type": "nest",
          "keys": [
            "subregion"
          ],
          "generate": true
        },
        {
          "type": "treemap",
          "field": "tonnes",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "squarify",
          "ratio": 1,
          "round": true,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 1,
          "paddingOuter": 2,
          "paddingTop": 18
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        },
        {
          "type": "lookup",
          "from": "region_totals",
          "key": "subregion",
          "fields": [
            "key"
          ],
          "values": [
            "total"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "tiles",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 2"
        },
        {
          "type": "formula",
          "as": "tw",
          "expr": "datum.x1 - datum.x0"
        },
        {
          "type": "formula",
          "as": "th",
          "expr": "datum.y1 - datum.y0"
        },
        {
          "type": "formula",
          "as": "num",
          "expr": "format(datum.tonnes / 1000, ',.0f')"
        },
        {
          "type": "formula",
          "as": "sp",
          "expr": "lastindexof(datum.country, ' ')"
        },
        {
          "type": "formula",
          "as": "cwid",
          "expr": "(datum.is_malaysia === 'True' || datum.is_malaysia === true ? 6.7 : 6.2)"
        },
        {
          "type": "formula",
          "as": "full_ok",
          "expr": "length(datum.country) * datum.cwid + 8 <= datum.tw"
        },
        {
          "type": "formula",
          "as": "num_ok",
          "expr": "length(datum.num) * datum.cwid + 8 <= datum.tw"
        },
        {
          "type": "formula",
          "as": "wrap_ok",
          "expr": "datum.sp > 0 && max(datum.sp, length(datum.country) - datum.sp - 1) * datum.cwid + 8 <= datum.tw"
        },
        {
          "type": "formula",
          "as": "line1",
          "expr": "datum.sp > 0 ? substring(datum.country, 0, datum.sp) : datum.country"
        },
        {
          "type": "formula",
          "as": "line2",
          "expr": "datum.sp > 0 ? substring(datum.country, datum.sp + 1) : ''"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "datum.full_ok && datum.num_ok && datum.th >= 30 ? [datum.country, datum.num] : datum.wrap_ok && datum.num_ok && datum.th >= 43 ? [datum.line1, datum.line2, datum.num] : datum.full_ok && datum.th >= 17 ? [datum.country] : datum.wrap_ok && datum.th >= 30 ? [datum.line1, datum.line2] : ['']"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "region",
      "type": "ordinal",
      "domain": [
        "Eastern Asia",
        "South-Eastern Asia",
        "Southern Asia",
        "Western Asia"
      ],
      "range": [
        "#8da0cb",
        "#66c2a5",
        "#fc8d62",
        "#e5c494"
      ]
    }
  ],
  "legends": [
    {
      "fill": "region",
      "orient": "bottom",
      "direction": "horizontal",
      "title": "Sub-region",
      "offset": 8,
      "symbolType": "square",
      "labelFontSize": 11,
      "titleFontSize": 11
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#f4f4f4"
          },
          "stroke": {
            "value": "#bbbbbb"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "tiles"
      },
      "encode": {
        "enter": {
          "tooltip": {
            "signal": "{'Country': datum.country, 'Sub-region': datum.subregion, 'Grain': datum.crop, 'Exports 2024 (tonnes)': format(datum.tonnes, ',.0f'), 'Share of Asia (%)': format(datum.share_of_asia_pct, '.1f')}"
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "region",
            "field": "subregion"
          },
          "stroke": [
            {
              "test": "datum.is_malaysia === 'True' || datum.is_malaysia === true",
              "value": "#08519c"
            },
            {
              "value": "#ffffff"
            }
          ],
          "strokeWidth": [
            {
              "test": "datum.is_malaysia === 'True' || datum.is_malaysia === true",
              "value": 3
            },
            {
              "value": 1
            }
          ]
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 4"
          },
          "y": {
            "signal": "datum.y0 + 3"
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "signal": "(length(datum.key + '  ·  ' + format(datum.total / 1000, ',.0f') + ' thousand tonnes') * 6.7 + 8 <= datum.x1 - datum.x0) ? datum.key + '  ·  ' + format(datum.total / 1000, ',.0f') + ' thousand tonnes' : (length(datum.key) * 6.7 + 8 <= datum.x1 - datum.x0 ? datum.key : '')"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#333333"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "tiles"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 4"
          },
          "y": {
            "signal": "datum.y0 + 3"
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "field": "label"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#1a1a1a"
          },
          "fontWeight": [
            {
              "test": "datum.is_malaysia === 'True' || datum.is_malaysia === true",
              "value": "bold"
            },
            {
              "value": "normal"
            }
          ]
        }
      }
    }
  ]
}