{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australian grain harvests swing widely from year to year",
    "subtitle": [
      "Annual production in million tonnes, 1961 to 2024. Grey bands mark major drought years",
      "Source: Food and Agriculture Organization of the United Nations"
    ],
    "anchor": "start",
    "frame": "bounds"
  },
  "data": {
    "url": "data/production_history.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "production_mt": "number",
        "area_mha": "number",
        "yield_t_ha": "number"
      }
    }
  },
  "facet": {
    "field": "crop",
    "type": "nominal",
    "sort": [
      "Wheat",
      "Barley",
      "Sorghum",
      "Oats"
    ],
    "header": {
      "title": null,
      "labelFontSize": 14,
      "labelFontWeight": "bold",
      "labelAlign": "left",
      "labelAnchor": "start"
    }
  },
  "columns": 2,
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "spec": {
    "width": 330,
    "height": 150,
    "encoding": {
      "x": {
        "field": "year",
        "type": "quantitative",
        "scale": {
          "domain": [
            1961,
            2024
          ],
          "nice": false
        },
        "axis": {
          "title": null,
          "format": "d",
          "tickCount": 6,
          "grid": false
        }
      },
      "y": {
        "field": "production_mt",
        "type": "quantitative",
        "axis": {
          "title": "Million tonnes",
          "tickCount": 4,
          "format": ".1~f"
        }
      }
    },
    "layer": [
      {
        "transform": [
          {
            "filter": "datum.year === 1967 || datum.year === 1982 || datum.year === 1994 || datum.year === 2002 || datum.year === 2006 || datum.year === 2018 || datum.year === 2019"
          },
          {
            "calculate": "datum.year - 0.5",
            "as": "b0"
          },
          {
            "calculate": "datum.year + 0.5",
            "as": "b1"
          }
        ],
        "mark": {
          "type": "rect",
          "color": "#9e9e9e",
          "opacity": 0.3
        },
        "encoding": {
          "x": {
            "field": "b0",
            "type": "quantitative"
          },
          "x2": {
            "field": "b1"
          },
          "y": {
            "value": 0
          },
          "y2": {
            "value": 150
          },
          "tooltip": [
            {
              "field": "year",
              "type": "quantitative",
              "title": "Drought year",
              "format": "d"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "area",
          "color": "#b30000",
          "opacity": 0.15
        },
        "encoding": {
          "y": {
            "field": "production_mt",
            "type": "quantitative"
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "color": "#b30000",
          "strokeWidth": 1.8
        },
        "encoding": {
          "tooltip": [
            {
              "field": "crop",
              "title": "Grain"
            },
            {
              "field": "year",
              "title": "Year",
              "format": "d"
            },
            {
              "field": "production_mt",
              "title": "Production (million tonnes)",
              "format": ",.2f"
            },
            {
              "field": "area_mha",
              "title": "Area harvested (million hectares)",
              "format": ",.2f"
            },
            {
              "field": "yield_t_ha",
              "title": "Yield (tonnes per hectare)",
              "format": ",.2f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum.note !== ''"
          }
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "color": "#b30000",
          "size": 55,
          "opacity": 1,
          "stroke": "white",
          "strokeWidth": 1
        }
      },
      {
        "transform": [
          {
            "filter": "datum.note === 'Record high' && datum.year <= 2005"
          },
          {
            "calculate": "'Record high ' + datum.year + ': ' + format(datum.production_mt, ',.1f') + ' million tonnes'",
            "as": "lbl"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 10,
          "color": "#333333",
          "dy": -9,
          "baseline": "bottom",
          "align": "left"
        },
        "encoding": {
          "text": {
            "field": "lbl"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.note === 'Record high' && datum.year > 2005"
          },
          {
            "calculate": "'Record high ' + datum.year + ': ' + format(datum.production_mt, ',.1f') + ' million tonnes'",
            "as": "lbl"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 10,
          "color": "#333333",
          "dy": -9,
          "baseline": "bottom",
          "align": "right"
        },
        "encoding": {
          "text": {
            "field": "lbl"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.note !== '' && datum.note !== 'Record high' && datum.year <= 2005"
          },
          {
            "calculate": "'Low ' + datum.year + ': ' + format(datum.production_mt, ',.1f') + ' million tonnes'",
            "as": "lbl"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 10,
          "color": "#333333",
          "baseline": "middle",
          "align": "left",
          "dx": 8
        },
        "encoding": {
          "text": {
            "field": "lbl"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.note !== '' && datum.note !== 'Record high' && datum.year > 2005"
          },
          {
            "calculate": "'Low ' + datum.year + ': ' + format(datum.production_mt, ',.1f') + ' million tonnes'",
            "as": "lbl"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 10,
          "color": "#333333",
          "baseline": "middle",
          "align": "right",
          "dx": -8
        },
        "encoding": {
          "text": {
            "field": "lbl"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.crop === 'Wheat' && (datum.year === 1967 || datum.year === 1982 || datum.year === 1994 || datum.year === 2002 || datum.year === 2006 || datum.year === 2018)"
          },
          {
            "calculate": "datum.year === 2018 ? datum.year + 0.5 : datum.year",
            "as": "xc"
          },
          {
            "calculate": "datum.year === 2018 ? '2018–19 drought' : datum.year + ' drought'",
            "as": "dl"
          }
        ],
        "mark": {
          "type": "text",
          "angle": 270,
          "align": "right",
          "baseline": "middle",
          "fontSize": 9,
          "color": "#555555"
        },
        "encoding": {
          "x": {
            "field": "xc",
            "type": "quantitative"
          },
          "y": {
            "value": 4
          },
          "text": {
            "field": "dl"
          }
        }
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 10,
      "titleFontSize": 10
    }
  }
}