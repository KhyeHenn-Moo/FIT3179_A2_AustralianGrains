{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 520,
  "title": {
    "text": "Grain production by state",
    "subtitle": [
      "Levied production in tonnes. Circle size (area) is proportional to tonnes",
      "Source: Australian Bureau of Statistics"
    ],
    "anchor": "start",
    "frame": "bounds"
  },
  "params": [
    {
      "name": "crop",
      "value": "Wheat"
    },
    {
      "name": "year",
      "value": "2024-25"
    },
    {
      "name": "maxT",
      "value": {
        "Wheat": 15000000,
        "Barley": 7000000,
        "Oats": 1000000,
        "Sorghum": 2000000
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ],
    "center": [
      0,
      -27
    ]
  },
  "layer": [
    {
      "data": {
        "url": "js/states_2021.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "js/states_2021.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "crop + '|' + year + '|' + datum.properties.STE_NAME21",
          "as": "key"
        },
        {
          "lookup": "key",
          "from": {
            "data": {
              "url": "data/state_grain.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "key",
            "fields": [
              "tonnes"
            ]
          },
          "as": [
            "tonnes_found"
          ]
        },
        {
          "filter": "!isValid(datum.tonnes_found)"
        },
        {
          "calculate": "'No ' + lower(crop) + ' production recorded for ' + year + ' (not zero)'",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.STE_NAME21",
            "title": "State"
          },
          {
            "field": "note",
            "title": "Data"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_grain.csv",
        "format": {
          "type": "csv",
          "parse": {
            "tonnes": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.crop === crop && datum.year === year"
        },
        {
          "calculate": "datum.tonnes / maxT[datum.crop]",
          "as": "share_of_max"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#b30000",
        "fillOpacity": 0.6,
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "share_of_max",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "range": [
              0,
              5000
            ]
          },
          "legend": {
            "title": "Production (tonnes)",
            "values": [
              0.1,
              0.5,
              1
            ],
            "labelExpr": "format(datum.value * maxT[crop], ',.0f')"
          }
        },
        "order": {
          "field": "tonnes",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "crop",
            "title": "Crop"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "tonnes",
            "title": "Tonnes",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}