{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 440,
  "height": 560,
  "title": {
    "text": "How the leading grain producers changed, 2004 to 2024",
    "subtitle": [
      "Production in million tonnes (FAOSTAT) of each crop's ten largest producers in 2024; Australia in red",
      "Vertical axis uses a log scale, so equal slopes mean equal percentage changes",
      "Sorghum: Sudan includes South Sudan, which was part of Sudan in 2004"
    ]
  },
  "params": [
    {
      "name": "crop",
      "value": "Wheat",
      "bind": {
        "input": "select",
        "options": [
          "Wheat",
          "Barley",
          "Oats",
          "Sorghum"
        ],
        "name": "Crop: "
      }
    }
  ],
  "data": {
    "url": "../data/production_slope.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "string",
        "production_mt": "number",
        "change_pct": "number",
        "rank_end": "number",
        "label_y": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.crop === crop"
    },
    {
      "calculate": "datum.label + '  ' + format(datum.production_mt, ',.1f')",
      "as": "lbl"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "!(datum.is_australia === 'True' || datum.is_australia === true)"
        }
      ],
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 50,
          "color": "#b0b0b0"
        },
        "color": "#b0b0b0",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 14,
            "labelFontWeight": "bold",
            "grid": false,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 0.5
          }
        },
        "y": {
          "field": "production_mt",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "zero": false,
            "nice": false,
            "padding": 12
          },
          "axis": null
        },
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "crop",
            "title": "Crop"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "production_mt",
            "title": "Production (million t)",
            "format": ",.2f"
          },
          {
            "field": "change_pct",
            "title": "Change 2004 to 2024 (%)",
            "format": "+,.1f"
          },
          {
            "field": "rank_end",
            "title": "Rank in 2024"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "(datum.is_australia === 'True' || datum.is_australia === true)"
        }
      ],
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 100,
          "color": "#b30000"
        },
        "color": "#b30000",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 14,
            "labelFontWeight": "bold",
            "grid": false,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 0.5
          }
        },
        "y": {
          "field": "production_mt",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "zero": false,
            "nice": false,
            "padding": 12
          },
          "axis": null
        },
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "crop",
            "title": "Crop"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "production_mt",
            "title": "Production (million t)",
            "format": ",.2f"
          },
          {
            "field": "change_pct",
            "title": "Change 2004 to 2024 (%)",
            "format": "+,.1f"
          },
          {
            "field": "rank_end",
            "title": "Rank in 2024"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2004'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 14,
            "labelFontWeight": "bold",
            "grid": false,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 0.5
          }
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "zero": false,
            "nice": false,
            "padding": 12
          },
          "axis": null
        },
        "text": {
          "field": "lbl"
        },
        "color": {
          "condition": {
            "test": "(datum.is_australia === 'True' || datum.is_australia === true)",
            "value": "#b30000"
          },
          "value": "#555555"
        },
        "fontWeight": {
          "condition": {
            "test": "(datum.is_australia === 'True' || datum.is_australia === true)",
            "value": "bold"
          },
          "value": "normal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2024'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 14,
            "labelFontWeight": "bold",
            "grid": false,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 0.5
          }
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "zero": false,
            "nice": false,
            "padding": 12
          },
          "axis": null
        },
        "text": {
          "field": "lbl"
        },
        "color": {
          "condition": {
            "test": "(datum.is_australia === 'True' || datum.is_australia === true)",
            "value": "#b30000"
          },
          "value": "#555555"
        },
        "fontWeight": {
          "condition": {
            "test": "(datum.is_australia === 'True' || datum.is_australia === true)",
            "value": "bold"
          },
          "value": "normal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "padding": {
    "left": 120,
    "right": 170,
    "top": 5,
    "bottom": 5
  }
}