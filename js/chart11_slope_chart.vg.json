{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 870,
  "height": 560,
  "title": {
    "text": "How the leading grain producers changed, 2004 to 2024",
    "subtitle": [
      "Production in million tonnes of each crop's ten largest producers in 2024. Australia in outlined in red",
      "Source: Food and Agriculture Organization of the United Nations"
    ],
    "anchor": "start",
    "frame": "bounds"
  },
  "params": [
    {
      "name": "crop",
      "value": "Wheat"
    }
  ],
  "data": {
    "url": "data/production_slope.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "string",
        "production_mt": "number",
        "change_pct": "number",
        "rank_end": "number",
        "label_y": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.crop === crop"
    },
    {
      "calculate": "(datum.label === 'USA' ? 'United States' : datum.label === 'UK' ? 'United Kingdom' : replace(datum.label, 'incl.', 'including')) + '  ' + format(datum.production_mt, ',.1f')",
      "as": "lbl"
    },
    {
      "calculate": "replace(datum.country, 'incl.', 'including')",
      "as": "country_name"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "!(datum.is_australia === 'True' || datum.is_australia === true)"
        }
      ],
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 50,
          "color": "#b0b0b0"
        },
        "color": "#b0b0b0",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 14,
            "labelFontWeight": "bold",
            "labelExpr": "datum.label + ' (million tonnes)'",
            "grid": false,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 1.475
          }
        },
        "y": {
          "field": "production_mt",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "zero": false,
            "nice": false,
            "padding": 12
          },
          "axis": null
        },
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "country_name",
            "title": "Country"
          },
          {
            "field": "crop",
            "title": "Crop"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "production_mt",
            "title": "Production (million tonnes)",
            "format": ",.2f"
          },
          {
            "field": "change_pct",
            "title": "Change 2004 to 2024 (%)",
            "format": "+,.1f"
          },
          {
            "field": "rank_end",
            "title": "Rank in 2024"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "(datum.is_australia === 'True' || datum.is_australia === true)"
        }
      ],
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 100,
          "color": "#b30000"
        },
        "color": "#b30000",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelFontWeight": "bold",
            "labelExpr": "datum.label + ' (million tonnes)'",
            "grid": false,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 1.475
          }
        },
        "y": {
          "field": "production_mt",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "zero": false,
            "nice": false,
            "padding": 12
          },
          "axis": null
        },
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "country_name",
            "title": "Country"
          },
          {
            "field": "crop",
            "title": "Crop"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "production_mt",
            "title": "Production (million tonnes)",
            "format": ",.2f"
          },
          {
            "field": "change_pct",
            "title": "Change 2004 to 2024 (%)",
            "format": "+,.1f"
          },
          {
            "field": "rank_end",
            "title": "Rank in 2024"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2004'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelFontWeight": "bold",
            "labelExpr": "datum.label + ' (million tonnes)'",
            "grid": false,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 1.475
          }
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "zero": false,
            "nice": false,
            "padding": 12
          },
          "axis": null
        },
        "text": {
          "field": "lbl"
        },
        "color": {
          "condition": {
            "test": "(datum.is_australia === 'True' || datum.is_australia === true)",
            "value": "#b30000"
          },
          "value": "#555555"
        },
        "fontWeight": {
          "condition": {
            "test": "(datum.is_australia === 'True' || datum.is_australia === true)",
            "value": "bold"
          },
          "value": "normal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2024'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelFontWeight": "bold",
            "labelExpr": "datum.label + ' (million tonnes)'",
            "grid": false,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 1.475
          }
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "zero": false,
            "nice": false,
            "padding": 12
          },
          "axis": null
        },
        "text": {
          "field": "lbl"
        },
        "color": {
          "condition": {
            "test": "(datum.is_australia === 'True' || datum.is_australia === true)",
            "value": "#b30000"
          },
          "value": "#555555"
        },
        "fontWeight": {
          "condition": {
            "test": "(datum.is_australia === 'True' || datum.is_australia === true)",
            "value": "bold"
          },
          "value": "normal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  }
}