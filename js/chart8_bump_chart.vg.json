{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 420,
  "title": {
    "text": "Australia's biggest grain buyers, ranked by period",
    "subtitle": [
      "Each line follows one buyer's rank by average annual tonnes taken from Australia (top 10 per period, rank 1 at the top)",
      "A dot with no line = in the top 10 in that period only",
      "Gap before 1996-00: FAOSTAT's 1992-95 trade records are incomplete, so those years are left out",
      "Malaysia in blue; where it ranks below 10th, its rank is written under the chart instead"
    ]
  },
  "params": [
    {
      "name": "crop",
      "value": "All Grains",
      "bind": {
        "input": "select",
        "options": [
          "All Grains",
          "Wheat",
          "Barley",
          "Oats",
          "Sorghum"
        ],
        "name": "Crop: "
      }
    }
  ],
  "data": {
    "url": "../data/buyer_rank.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rank": "number",
        "tonnes": "number",
        "avg_annual_t": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.crop === crop"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.rank <= 10 && !(datum.is_malaysia === 'True' || datum.is_malaysia === true)"
        },
        {
          "impute": "rank",
          "key": "period",
          "keyvals": [
            "1986-91",
            "1996-00",
            "2001-05",
            "2006-10",
            "2011-15",
            "2016-20",
            "2021-24"
          ],
          "groupby": [
            "partner"
          ],
          "value": null
        }
      ],
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 50,
          "color": "#b0b0b0"
        },
        "color": "#b0b0b0",
        "strokeWidth": 2,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "1986-91",
            "1996-00",
            "2001-05",
            "2006-10",
            "2011-15",
            "2016-20",
            "2021-24"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "grid": false,
            "orient": "top"
          },
          "scale": {
            "paddingOuter": 0.1
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              11.8,
              0.5
            ]
          },
          "axis": null
        },
        "detail": {
          "field": "partner",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "partner",
            "title": "Buyer"
          },
          {
            "field": "period",
            "title": "Period"
          },
          {
            "field": "rank",
            "title": "Rank",
            "type": "quantitative"
          },
          {
            "field": "avg_annual_t",
            "title": "Average tonnes per year",
            "type": "quantitative",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rank <= 10 && (datum.is_malaysia === 'True' || datum.is_malaysia === true)"
        },
        {
          "impute": "rank",
          "key": "period",
          "keyvals": [
            "1986-91",
            "1996-00",
            "2001-05",
            "2006-10",
            "2011-15",
            "2016-20",
            "2021-24"
          ],
          "groupby": [
            "partner"
          ],
          "value": null
        }
      ],
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 90,
          "color": "#08519c"
        },
        "color": "#08519c",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "1986-91",
            "1996-00",
            "2001-05",
            "2006-10",
            "2011-15",
            "2016-20",
            "2021-24"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "grid": false,
            "orient": "top"
          },
          "scale": {
            "paddingOuter": 0.1
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              11.8,
              0.5
            ]
          },
          "axis": null
        },
        "detail": {
          "field": "partner",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "partner",
            "title": "Buyer"
          },
          {
            "field": "period",
            "title": "Period"
          },
          {
            "field": "rank",
            "title": "Rank",
            "type": "quantitative"
          },
          {
            "field": "avg_annual_t",
            "title": "Average tonnes per year",
            "type": "quantitative",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rank <= 10 && datum.period === '2021-24'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "1986-91",
            "1996-00",
            "2001-05",
            "2006-10",
            "2011-15",
            "2016-20",
            "2021-24"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "grid": false,
            "orient": "top"
          },
          "scale": {
            "paddingOuter": 0.1
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              11.8,
              0.5
            ]
          },
          "axis": null
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "(datum.is_malaysia === 'True' || datum.is_malaysia === true)",
            "value": "#08519c"
          },
          "value": "#444444"
        },
        "fontWeight": {
          "condition": {
            "test": "(datum.is_malaysia === 'True' || datum.is_malaysia === true)",
            "value": "bold"
          },
          "value": "normal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rank <= 10 && datum.period === '1986-91'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "1986-91",
            "1996-00",
            "2001-05",
            "2006-10",
            "2011-15",
            "2016-20",
            "2021-24"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "grid": false,
            "orient": "top"
          },
          "scale": {
            "paddingOuter": 0.1
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              11.8,
              0.5
            ]
          },
          "axis": null
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "(datum.is_malaysia === 'True' || datum.is_malaysia === true)",
            "value": "#08519c"
          },
          "value": "#444444"
        },
        "fontWeight": {
          "condition": {
            "test": "(datum.is_malaysia === 'True' || datum.is_malaysia === true)",
            "value": "bold"
          },
          "value": "normal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "(datum.is_malaysia === 'True' || datum.is_malaysia === true) && datum.rank > 10"
        },
        {
          "calculate": "'Malaysia: #' + datum.rank",
          "as": "my_text"
        },
        {
          "calculate": "11.4",
          "as": "ypos"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#08519c"
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "1986-91",
            "1996-00",
            "2001-05",
            "2006-10",
            "2011-15",
            "2016-20",
            "2021-24"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "grid": false,
            "orient": "top"
          },
          "scale": {
            "paddingOuter": 0.1
          }
        },
        "y": {
          "field": "ypos",
          "type": "quantitative",
          "scale": {
            "domain": [
              11.8,
              0.5
            ]
          },
          "axis": null
        },
        "text": {
          "field": "my_text"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}